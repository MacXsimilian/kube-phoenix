# Backend
DATABASE_URL=postgres://kube_phoenix:kube_phoenix@localhost:5432/kube_phoenix?sslmode=disable
BASIC_AUTH_USER=          # Leave empty to disable auth (dev mode)
BASIC_AUTH_PASSWORD=      # Leave empty to disable auth (dev mode)
CORS_ALLOWED_ORIGIN=      # e.g. http://localhost:3000 — ignored in dev mode (wildcard)

# Frontend (build-time)
NEXT_PUBLIC_API_URL=http://localhost:8080   # Backend URL for dev
NEXT_PUBLIC_APP_VERSION=dev                 # Shown in About modal
