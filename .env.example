# Backend
DATABASE_URL=postgres://kube_phoenix:kube_phoenix@localhost:5432/kube_phoenix?sslmode=disable
ADMIN_USER=               # Seeds admin account on first startup. Blank skips seeding; authentication stays enabled
ADMIN_PASSWORD=           # Admin password (min 8 chars)
CORS_ALLOWED_ORIGIN=      # Required for a separate frontend origin, e.g. http://localhost:3000
CLUSTER_NAME=              # Human-readable name for GET /api/cluster/info (optional)
#COOKIE_SECURE=false       # Set false for local HTTP; defaults to true for HTTPS deployments

# Database connection pool (optional — defaults shown)
#DB_MAX_OPEN_CONNS=10         # max concurrent open connections to PostgreSQL
#DB_MAX_IDLE_CONNS=5          # max idle connections kept in the pool
#DB_CONN_MAX_LIFETIME_MIN=5   # max connection lifetime in minutes

# Frontend (build-time)
NEXT_PUBLIC_API_URL=http://localhost:8080   # Backend URL for dev
NEXT_PUBLIC_APP_VERSION=dev                 # Shown in About modal
NEXT_PUBLIC_PROTOTYPES=                     # Set to "1" to enable /prototypes route (dev-mock only)
