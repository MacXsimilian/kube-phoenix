{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "kube-phoenix Helm Values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "nameOverride": {
      "type": "string",
      "description": "Override the chart name."
    },
    "fullnameOverride": {
      "type": "string",
      "description": "Override the full release name."
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": { "name": { "type": "string" } },
        "required": ["name"]
      }
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "revisionHistoryLimit": {
      "type": "integer",
      "minimum": 0
    },
    "strategy": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["RollingUpdate", "Recreate"] },
        "rollingUpdate": {
          "type": "object",
          "properties": {
            "maxSurge": { "oneOf": [{ "type": "integer" }, { "type": "string" }] },
            "maxUnavailable": { "oneOf": [{ "type": "integer" }, { "type": "string" }] }
          }
        }
      }
    },
    "namespaceOverride": { "type": "string" },
    "createNamespace": { "type": "boolean" },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" }
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" }
      }
    },
    "postgresql": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": { "type": "string" },
            "tag": { "type": "string" },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "username": { "type": "string" },
            "password": { "type": "string" },
            "database": { "type": "string" }
          },
          "required": ["username", "password", "database"]
        },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "size": { "type": "string", "pattern": "^[0-9]+(Gi|Mi|Ti)$" },
            "storageClass": { "type": "string" }
          }
        },
        "resources": { "$ref": "#/$defs/resources" }
      }
    },
    "externalDatabase": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string" },
        "host": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "username": { "type": "string" },
        "password": { "type": "string" },
        "database": { "type": "string" },
        "sslmode": { "type": "string", "enum": ["disable", "require", "verify-ca", "verify-full"] }
      }
    },
    "secret": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": { "type": "string" },
        "adminUser": { "type": "string" },
        "adminPassword": { "type": "string" }
      }
    },
    "db": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxOpenConns": { "type": "integer", "minimum": 1 },
        "maxIdleConns": { "type": "integer", "minimum": 0 },
        "connMaxLifetimeMinutes": { "type": "integer", "minimum": 1 }
      }
    },
    "k8s": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "qps": { "type": "integer", "minimum": 1 },
        "burst": { "type": "integer", "minimum": 1 }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "idleTimeout": { "type": "string", "pattern": "^[0-9]+(s|m|h)$" },
        "maxLifetime": { "type": "string", "pattern": "^[0-9]+(s|m|h)$" },
        "cookieSecure": { "type": "boolean" }
      }
    },
    "auditRetentionDays": {
      "type": "integer",
      "minimum": 0
    },
    "oidc": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "issuerURL": { "type": "string" },
        "clientID": { "type": "string" },
        "clientSecret": { "type": "string" },
        "redirectURL": { "type": "string" },
        "groupsClaim": { "type": "string" },
        "roleAdminGroups": { "type": "string" },
        "roleOperatorGroups": { "type": "string" },
        "skipTLSVerify": { "type": "boolean" },
        "caConfigMap": { "type": "string" },
        "caCertKey": { "type": "string" }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "targetPort": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "host": { "type": "string" },
        "tls": { "type": "array" }
      }
    },
    "targetGroupBinding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "targetGroupARN": { "type": "string" },
        "targetType": { "type": "string", "enum": ["ip", "instance"] },
        "vpcID": { "type": "string" }
      }
    },
    "resources": { "$ref": "#/$defs/resources" },
    "podSecurityContext": { "type": "object" },
    "containerSecurityContext": { "type": "object" },
    "livenessProbe": { "$ref": "#/$defs/probe" },
    "readinessProbe": { "$ref": "#/$defs/probe" },
    "startupProbe": { "$ref": "#/$defs/probe" },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "topologySpreadConstraints": { "type": "array" },
    "priorityClassName": { "type": "string" },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "oneOf": [{ "type": "integer" }, { "type": "string" }] },
        "maxUnavailable": { "oneOf": [{ "type": "integer" }, { "type": "string" }] }
      }
    },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "extraEnv": { "type": "array" },
    "extraEnvFrom": { "type": "array" },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "podAnnotations": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" }
          }
        },
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "namespace": { "type": "string" },
            "interval": { "type": "string" },
            "scrapeTimeout": { "type": "string" },
            "labels": { "type": "object" }
          }
        }
      }
    }
  },
  "$defs": {
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object",
          "properties": {
            "cpu": { "oneOf": [{ "type": "string" }, { "type": "number" }] },
            "memory": { "type": "string" }
          }
        },
        "limits": {
          "type": "object",
          "properties": {
            "cpu": { "oneOf": [{ "type": "string" }, { "type": "number" }] },
            "memory": { "type": "string" }
          }
        }
      }
    },
    "probe": {
      "type": "object",
      "properties": {
        "httpGet": {
          "type": "object",
          "properties": {
            "path": { "type": "string" },
            "port": { "oneOf": [{ "type": "integer" }, { "type": "string" }] }
          }
        },
        "initialDelaySeconds": { "type": "integer", "minimum": 0 },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 },
        "successThreshold": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
